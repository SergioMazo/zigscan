#!/usr/bin/env bash
#
# zigscan — Zigbee site survey for AV integrators.
#
# One entry point so a technician has one thing to remember.
#
#   ./zigscan survey             open the local web console
#   ./zigscan scan [seconds]     sweep all 16 channels from the terminal
#   ./zigscan census             identify networks and vendor evidence
#   ./zigscan verdict            distinguish interference from a mesh problem
#   ./zigscan wifi               measure Wi-Fi across all bands
#   ./zigscan identify           identify the radio and its firmware
#   ./zigscan capture <ch> <s>   record one channel to a PCAP
#   ./zigscan report <file>      summarize frames and RSSI from a PCAP

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="$HERE/.venv/bin/python"

CMD="${1:-survey}"
shift || true

# Help must work before setup — it is the first thing someone types.
if [[ "$CMD" == "-h" || "$CMD" == "--help" || "$CMD" == "help" ]]; then
  sed -n '5,14p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

if [[ ! -x "$PY" ]]; then
  echo "Not set up yet. Run ./setup.sh first." >&2
  exit 1
fi

case "$CMD" in
  survey|console|ui)
    exec "$PY" "$HERE/tools/console.py" --open "$@"
    ;;
  scan)
    exec "$PY" "$HERE/tools/capture.py" "$@"
    ;;
  identify|id)
    exec "$PY" "$HERE/tools/identify.py" "$@"
    ;;
  capture|sniff)
    exec "$PY" "$HERE/tools/capture.py" capture "$@"
    ;;
  census)
    exec "$PY" "$HERE/tools/census.py" "$@"
    ;;
  verdict|diag)
    exec "$PY" "$HERE/tools/verdict.py" "$@"
    ;;
  wifi)
    exec "$PY" "$HERE/tools/wifi.py" "$@"
    ;;
  report|summary)
    exec "$PY" "$HERE/tools/pcap_summary.py" "$@"
    ;;
  convert)
    exec "$PY" "$HERE/tools/pcap_convert.py" "$@"
    ;;
  *)
    echo "Unknown command: $CMD" >&2
    echo "Try: ./zigscan help" >&2
    exit 2
    ;;
esac
